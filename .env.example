# Copy to .env (never commit .env). Only needed for the optional LIVE path.
# The default REPLAY demo needs no key.
OPENAI_API_KEY=
# Model identifier used by the live Responses API adapter (recorded in every live report).
NEM_AGENT_MODEL=gpt-5-mini
# Hard caps for the live path.
NEM_AGENT_MAX_MODEL_CALLS=8
NEM_AGENT_SESSION_BUDGET_USD=0.50
NEM_AGENT_API_TIMEOUT_S=60
# Experimental, off by default (D31 Amendment 1): 1 routes with the request plan (contract v16, prompts v17);
# NEM_AGENT_PLAN_POLICY chooses its stated-basis policy, V1 (default) or V0. Not evaluated in Live.
NEM_AGENT_ROUTE_PLAN=0
NEM_AGENT_PLAN_POLICY=V1
# Optional (D33): the reasoning effort of routing calls only: minimal, low, medium or high; any other value is
# refused. Unset (the default), nothing is sent and the provider's default applies. Tool, synthesis and repair calls
# never send it. Its effect on latency and on extraction quality is unmeasured.
# NEM_AGENT_ROUTE_REASONING_EFFORT=low
# Optional (D37): Standard Live's tool-selection turns are asked to reply DONE, instead of writing an answer, when no
# further tool is needed (prompt variant tool-turn-done/1). Off by default; any value but 1/true/yes/on or 0/false/no/off
# is refused. Its effect on latency and on answer quality is unmeasured.
# NEM_AGENT_LIVE_TOOL_TURN_DONE=1
