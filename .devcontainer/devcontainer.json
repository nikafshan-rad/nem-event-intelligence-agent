{
  "name": "nem-event-intelligence-agent",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "make setup SYSTEM_PY=python3",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": {"label": "FastAPI (make api)", "onAutoForward": "notify"},
    "8501": {"label": "Streamlit (make app)", "onAutoForward": "openBrowser"}
  },
  "secrets": {
    "OPENAI_API_KEY": {"description": "Optional. Only for the LIVE path (make eval-live / live-smoke). Replay needs no key."}
  },
  "customizations": {"vscode": {"extensions": ["ms-python.python", "charliermarsh.ruff"]}}
}
